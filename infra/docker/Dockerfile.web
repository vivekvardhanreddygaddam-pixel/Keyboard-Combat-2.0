# ==============================================================================
# TypeVector Arena — Frontend Multi-Page Static Shell & Reverse Proxy
# Multi-stage build: Node.js 20 build -> Nginx 1.27 Alpine runtime
# ==============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

# Enable corepack and install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy root workspace configurations
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages ./packages

# Install web dependencies
RUN pnpm install --frozen-lockfile

# Copy web frontend source files
COPY apps/web ./apps/web

# Build static production bundle
RUN pnpm --filter @typevector/web build

# ==============================================================================
# Stage 2: Hardened Nginx Alpine Runtime
# ==============================================================================
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

USER root
# Remove default nginx welcome page
RUN rm -rf /usr/share/nginx/html/* && chown -R 101:101 /usr/share/nginx/html

# Copy built multi-page static assets
COPY --from=builder --chown=101:101 /app/apps/web/dist /usr/share/nginx/html

# Copy custom hardened nginx configuration
COPY --chown=101:101 infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

# Drop all privileges (nginx-unprivileged runs as UID 101)
USER 101

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:8080/ || exit 1

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
