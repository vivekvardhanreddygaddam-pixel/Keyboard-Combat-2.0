# ==============================================================================
# TypeVector Arena — Hardened Production API & Worker Dockerfile
# Multi-stage build, minimal Debian slim base, non-root user, pinned dependencies
# ==============================================================================

# Stage 1: Build virtual environment with uv
FROM python:3.12-slim-bookworm AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv from official binary
COPY --from=ghcr.io/astral-sh/uv:0.5.26 /uv /uvx /bin/

# Copy dependency specifications
COPY pyproject.toml uv.lock README.md ./

# Install production dependencies into /app/.venv
RUN uv sync --frozen --no-dev --no-install-project

# Copy source code and install project package
COPY apps/api/src ./apps/api/src
RUN uv sync --frozen --no-dev

# ==============================================================================
# Stage 2: Final Minimal Runtime Image
# ==============================================================================
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/apps/api/src" \
    APP_ENV=production \
    APP_HOST=0.0.0.0 \
    APP_PORT=8000

WORKDIR /app

# Install minimal runtime shared libraries (curl for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create secure non-privileged system user (UID 10001)
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /sbin/nologin -M appuser

# Copy virtual environment from builder
COPY --from=builder --chown=appuser:appgroup /app/.venv /app/.venv
COPY --from=builder --chown=appuser:appgroup /app/apps/api/src /app/apps/api/src

# Create writable temp directory for appuser if needed
RUN mkdir -p /tmp/typevector && chown -R appuser:appgroup /tmp/typevector

# Drop all privileges
USER appuser:appgroup

# Graceful termination signal
STOPSIGNAL SIGTERM

EXPOSE 8000

# Container liveness check
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/healthz || exit 1

# Default command: run FastAPI production ASGI server
CMD ["uvicorn", "typevector.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips", "*"]
