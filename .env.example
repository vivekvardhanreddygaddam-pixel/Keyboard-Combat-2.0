# TypeVector Arena — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git.

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql+asyncpg://typevector:local_dev_password@localhost:5432/typevector_dev
DATABASE_URL_SYNC=postgresql+psycopg://typevector:local_dev_password@localhost:5432/typevector_dev

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === Application ===
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_generate_a_random_64_char_hex_string
APP_HOST=127.0.0.1
APP_PORT=8000

# === CORS (comma-separated origins) ===
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Session ===
SESSION_COOKIE_NAME=tv_session
SESSION_MAX_AGE_SECONDS=604800

# === Supabase (Optional Cloud Database & Services) ===
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here


