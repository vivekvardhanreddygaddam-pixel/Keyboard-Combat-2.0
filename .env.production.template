# ==============================================================================
# TypeVector Arena — Production Environment Configuration Template
# COPY TO: .env.production on target host. NEVER commit real secrets to git.
# ==============================================================================

# === Application Environment ===
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# === Cryptographic Secrets ===
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_64_CHAR_HEX_SECRET

# === Database (Authoritative PostgreSQL System of Record) ===
POSTGRES_USER=typevector
POSTGRES_PASSWORD=REPLACE_WITH_COMPLEX_DATABASE_PASSWORD
POSTGRES_DB=typevector_prod
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Database Connection Pool Sizing
# Keep total connections (FastAPI workers * pool_size + Celery workers) <= postgres max_connections (100)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# === Redis (Ephemeral Broker & Coordination Cache) ===
REDIS_URL=redis://redis:6379/0

# === Celery Background Workers ===
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# === CORS & WebSocket Origin Security ===
# Strict allowlist of production domains (NO WILDCARDS in production)
CORS_ORIGINS=https://arena.typevector.com,https://typevector.com

# === Session & Cookie Hardening ===
SESSION_COOKIE_NAME=tv_session
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# === Outbox Email Notifications (SMTP Provider) ===
# Set to true only when genuine production SMTP credentials are provisioned
SMTP_ENABLED=false
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_ACCESS_KEY
SMTP_PASSWORD=REPLACE_WITH_SMTP_SECRET_KEY
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=notifications@typevector.com
SMTP_FROM_NAME="TypeVector Arena Notifications"

# === Export File Storage Lifecycle ===
EXPORT_STORAGE_PATH=/tmp/typevector/exports
EXPORT_EXPIRY_DAYS=7
