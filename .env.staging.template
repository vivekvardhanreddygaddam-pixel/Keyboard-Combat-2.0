# ==============================================================================
# TypeVector Arena — Staging Environment Configuration Template
# COPY TO: .env.staging on staging host. NEVER commit real secrets to git.
# ==============================================================================

# === Application Environment ===
APP_ENV=staging
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# === Cryptographic Secrets ===
APP_SECRET_KEY=REPLACE_WITH_STAGING_64_CHAR_HEX_SECRET

# === Database (Authoritative PostgreSQL System of Record) ===
POSTGRES_USER=typevector_staging
POSTGRES_PASSWORD=REPLACE_WITH_STAGING_DATABASE_PASSWORD
POSTGRES_DB=typevector_staging
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# === Redis (Ephemeral Broker & Coordination Cache) ===
REDIS_URL=redis://redis:6379/0

# === Celery Background Workers ===
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# === CORS & WebSocket Origin Security ===
CORS_ORIGINS=https://staging.typevector.com,https://staging-arena.typevector.com

# === Session & Cookie Hardening ===
SESSION_COOKIE_NAME=tv_session_staging
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# === Outbox Email Notifications (Mock / Log-Only Provider in Staging) ===
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=staging-notifications@typevector.com
SMTP_FROM_NAME="TypeVector Arena Staging"

# === Export File Storage Lifecycle ===
EXPORT_STORAGE_PATH=/tmp/typevector/exports
EXPORT_EXPIRY_DAYS=7
